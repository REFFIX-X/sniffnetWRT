# /etc/config/sniffnetwrt — sniffnetWRT UCI configuration

config monitor 'wan'
	# Capture device. Empty => auto-detect the WAN device via ubus/netifd.
	# Set explicitly for PPPoE/VLAN setups, e.g. 'eth1', 'wan', 'eth0.2'.
	option device ''

	# Web UI / WebSocket listen port.
	option port '9999'

	# Bind address. Use the LAN IP (e.g. 192.168.1.1) to avoid exposing the UI
	# on the WAN side. 0.0.0.0 binds all interfaces (NOT recommended).
	option bind '0.0.0.0'

	# Optional token required as ?token=... on the /ws connection.
	option token ''

	# Optional BPF filter, e.g. 'tcp port 443'. Empty = capture everything.
	option bpf ''

	# Directory containing GeoLite2-{Country,ASN}.mmdb (optional).
	option mmdb_dir '/usr/share/sniffnetwrt'

	# Optional IP/CIDR blacklist file (one per line).
	option blacklist ''

	# Optional webhook URL for remote notifications (SIGNL4/IFTTT/ntfy/...).
	option webhook ''

	# Notify when total throughput exceeds this many bytes/second (optional).
	option notify_threshold ''

	# Snapshot broadcast interval in milliseconds.
	option interval_ms '1000'
